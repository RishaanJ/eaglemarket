# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables and local overrides
.env
.env.*
!.env.example
!.env.*.example

# OAuth, cloud-provider, and service-account credentials
client_secret_*.json
credentials*.json
service-account*.json
service_account*.json
google-credentials*.json
firebase-adminsdk-*.json
*.credentials.json

# private keys, certificates, and keystores
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# package-manager and deployment auth
.npmrc
.yarnrc.yml.local
.netrc

# local Supabase state and secrets
/supabase/.temp/
/supabase/.branches/
/supabase/.env*
!/supabase/.env.example

# local MCP configuration may contain access tokens
.mcp.local.json
.mcp.json.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
